# ==============================================================================
# JOJIRA DUFFEL DEPLOYMENT CONFIGURATION VARIABLES
# Plug in your Azure & ArgoCD details below before running deployment scripts.
# ==============================================================================

# Azure Subscription & Resource Group
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-jojira-prod"
AZURE_LOCATION="eastus"

# Azure Container Registry (ACR) Name (e.g. jojiraacr)
AZURE_ACR_NAME="jojiraacr"

# Azure Kubernetes Service (AKS) Cluster Name (e.g. jojira-aks)
AZURE_AKS_CLUSTER="jojira-aks"

# Azure Key Vault Name (e.g. jojira-kv)
AZURE_KEYVAULT_NAME="jojira-kv"
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"

# ArgoCD Configuration & GitOps Repository
# ArgoCD continuously syncs manifests from your Git repository to AKS.
ARGOCD_SERVER="argocd.yourdomain.com"
ARGOCD_NAMESPACE="argocd"
ARGOCD_APP_NAME="jojira-duffel-app"
ARGOCD_GIT_REPO_URL="https://github.com/knpillutla/jojira-duffel.git"
ARGOCD_GIT_TARGET_REVISION="HEAD"
ARGOCD_GIT_PATH="deploy/k8s"

# Target Kubernetes Namespace
K8S_NAMESPACE="jojira"

# Docker Image Tag (Defaults to 'latest' or dynamic Git SHA/timestamp)
IMAGE_TAG="latest"
