# ==============================================================================
# AZURE CONTAINER APPS (ACA) DEPLOYMENT CONFIGURATION VARIABLES
# Fill in your Azure Subscription, Resource Group, ACR, and Key Vault details below.
# ==============================================================================

# Azure Subscription & Resource Group
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-jojira-prod"
AZURE_LOCATION="eastus"

# Azure Container Apps Environment Name (e.g. cae-jojira-prod)
AZURE_CONTAINER_APP_ENV="cae-jojira-prod"

# Azure Container Registry (ACR) Name (e.g. jojiraacr)
AZURE_ACR_NAME="jojiraacr"

# Azure Key Vault Name (e.g. jojira-kv)
AZURE_KEYVAULT_NAME="jojira-kv"

# Container App Names for Microservices
CONTAINER_APP_API_NAME="ca-jojira-api"
CONTAINER_APP_USER_SERVICE_NAME="ca-jojira-user-service"
CONTAINER_APP_ORDER_SERVICE_NAME="ca-jojira-order-service"

# Target Docker Image Tag (Defaults to 'latest' or Git SHA)
IMAGE_TAG="latest"
