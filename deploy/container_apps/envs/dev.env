# ==============================================================================
# DEV ENVIRONMENT CONFIGURATION
# ==============================================================================
ENVIRONMENT="dev"
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-jojira-dev"
AZURE_LOCATION="eastus"

AZURE_CONTAINER_APP_ENV="cae-jojira-dev"
AZURE_ACR_NAME="jojiraacrdev"
AZURE_KEYVAULT_NAME="jojira-kv-dev"

CONTAINER_APP_API_NAME="ca-jojira-api-dev"
CONTAINER_APP_USER_SERVICE_NAME="ca-jojira-user-service-dev"
CONTAINER_APP_ORDER_SERVICE_NAME="ca-jojira-order-service-dev"

# Runtime Application Configurations (Injected into container without rebuilding)
DEFAULT_ORDER_MODE="hold"
LLM_PROVIDER="openai"
AZURE_KEYVAULT_ENABLED="true"
