# ==============================================================================
# DEV ENVIRONMENT CONFIGURATION (Serverless Container App Dev Environment)
# ==============================================================================
ENVIRONMENT="dev"
AZURE_SUBSCRIPTION_NAME="JOJIRA_DEV"
AZURE_RESOURCE_GROUP="rg-containerapp-dev"
AZURE_LOCATION="East US"

AZURE_CONTAINER_APP_ENV="cae-jojira-dev-env"
AZURE_ACR_NAME="jojiraserverlessacr"
AZURE_KEYVAULT_NAME="jojiradevcakv"

CONTAINER_APP_API_NAME="app-jojira-dev"
CONTAINER_APP_USER_SERVICE_NAME="app-jojira-user-service-dev"
CONTAINER_APP_ORDER_SERVICE_NAME="app-jojira-order-service-dev"
CONTAINER_APP_POSTGRES_NAME="app-jojira-postgres-dev"
CONTAINER_APP_REDIS_NAME="app-jojira-redis-dev"
CONTAINER_APP_RABBITMQ_NAME="app-jojira-rabbitmq-dev"

# Resource & Scaling Limits
CPU="0.25"
MEMORY="0.5Gi"
MIN_REPLICAS="0"
MAX_REPLICAS="10"

# Runtime Application Configurations
DEFAULT_ORDER_MODE="instant"
LLM_PROVIDER="openai"
AZURE_KEYVAULT_ENABLED="true"
