# ==============================================================================
# PROD ENVIRONMENT CONFIGURATION (Serverless Container App Prod Environment)
# ==============================================================================
ENVIRONMENT="prod"
AZURE_SUBSCRIPTION_NAME="JOJIRA_PROD"
AZURE_RESOURCE_GROUP="rg-containerapp-prod"
AZURE_LOCATION="East US 2"

AZURE_CONTAINER_APP_ENV="cae-jojira-prod"
AZURE_ACR_NAME="jojiraserverlessprodacr"
AZURE_KEYVAULT_NAME="jojiraprodcakv"

CONTAINER_APP_API_NAME="app-jojira-prod"
CONTAINER_APP_USER_SERVICE_NAME="app-jojira-user-service-prod"
CONTAINER_APP_ORDER_SERVICE_NAME="app-jojira-order-service-prod"

# Resource & Scaling Limits
CPU="0.5"
MEMORY="1.0Gi"
MIN_REPLICAS="1"
MAX_REPLICAS="25"

# Runtime Application Configurations
DEFAULT_ORDER_MODE="instant"
LLM_PROVIDER="openai"
AZURE_KEYVAULT_ENABLED="true"
