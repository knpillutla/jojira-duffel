# ==============================================================================
# PROD ENVIRONMENT CONFIGURATION
# ==============================================================================
ENVIRONMENT="prod"
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-jojira-prod"
AZURE_LOCATION="eastus"

AZURE_CONTAINER_APP_ENV="cae-jojira-prod"
AZURE_ACR_NAME="jojiraacrprod"
AZURE_KEYVAULT_NAME="jojira-kv-prod"

CONTAINER_APP_API_NAME="ca-jojira-api-prod"
CONTAINER_APP_USER_SERVICE_NAME="ca-jojira-user-service-prod"
CONTAINER_APP_ORDER_SERVICE_NAME="ca-jojira-order-service-prod"

# Runtime Application Configurations (Injected into container without rebuilding)
DEFAULT_ORDER_MODE="hold"
LLM_PROVIDER="openai"
AZURE_KEYVAULT_ENABLED="true"
