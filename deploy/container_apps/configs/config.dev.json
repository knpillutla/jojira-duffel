{
  "environment": "dev",
  "base_url": "https://api.duffel.com",
  "api_version": "v2",
  "timeout": 5.0,
  "force_instant_booking": false,
  "default_order_mode": "hold",
  "azure_keyvault_enabled": true,
  "azure_keyvault_name": "jojira-kv-dev",
  "azure_keyvault_url": "https://jojira-kv-dev.vault.azure.net/",
  "debug": true,
  "test_mode": false,
  "enable_cache": true,
  "redis_host": "127.0.0.1",
  "redis_port": 6379,
  "redis_db": 0,
  "cache_ttl_seconds": 3600,
  "max_cached_offers": 40,
  "max_non_stop_offers": 10,
  "gemini_model": "gemini-1.5-flash",
  "gemini_enabled": true,
  "openai_model": "gpt-4o-mini",
  "openai_enabled": true,
  "llm_provider": "openai",
  "service_bus_enabled": true,
  "service_bus_queue_name": "order-hold-events-dev",
  "email_confirmation_enabled": true
}
